# BFF only. No migration, worker, lifecycle or provider-administrator credentials belong here.
# Store the real file outside the checkout, owned by the service/secret manager with mode 0600.
DEPLOY_ENV=production
APP_ORIGIN=https://habit.saraftech.com
RELEASE_ID=REPLACE-IMMUTABLE-RELEASE
SESSION_ENCRYPTION_KEY=REPLACE-WITH-64-HEX-CHARACTERS
INSTALLATION_ID=REPLACE-INSTALLATION-UUID
SUPABASE_PROJECT_REF=REPLACE-PRODUCTION-PROJECT-REF
SUPABASE_URL=https://REPLACE-PRODUCTION-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE-PUBLISHABLE-KEY
DATABASE_URL=postgresql://rise_bff_login:REPLACE-BFF-PASSWORD@db.REPLACE-PRODUCTION-PROJECT-REF.supabase.co:5432/postgres
BIND_HOST=127.0.0.1
PORT=8080
STATIC_DIRECTORY=dist
# Optional provider CA, as one quoted PEM value with literal \n separators. Verification stays enabled.
# DATABASE_CA_CERT="REPLACE-PEM"
