{
  "name": "rise-prototype",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "build:native": "npm run build && cap sync",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "lint": "oxlint src server infra tests scripts public/notifications-sw.js *.config.ts --deny-warnings",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json && tsc --noEmit -p tsconfig.server.json",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots=all",
    "check": "npm run check:toolchain && npm run check:notices && npm run lint && npm run typecheck && npm test && npm run build && npm run build:review",
    "dev:review": "vite --mode review --host 127.0.0.1 --port 4174 --strictPort",
    "build:review": "tsc -b && vite build --mode review",
    "preview:review": "vite preview --mode review --host 127.0.0.1 --port 4174 --strictPort",
    "test:production": "playwright test --config playwright.production.config.ts",
    "test:pwa": "playwright test --config playwright.pwa.config.ts",
    "server:start": "node --import tsx server/main.ts",
    "server:local": "node --import tsx --env-file=.rise-infra/local/server.env server/local.ts",
    "check:local-browser": "node --import tsx scripts/infra/check-local-browser.ts",
    "check:push-load": "node --import tsx scripts/infra/check-push-load.ts",
    "check:docs": "node scripts/check-docs.mjs",
    "check:publication": "node scripts/check-publication.mjs",
    "infra:up": "tsx scripts/infra/local.ts up",
    "infra:stop": "tsx scripts/infra/local.ts stop",
    "infra:verify": "tsx scripts/infra/local.ts verify",
    "lifecycle:run": "node --import tsx scripts/infra/lifecycle.ts run",
    "lifecycle:watch": "node --import tsx scripts/infra/lifecycle.ts watch",
    "lifecycle:ledger": "node --import tsx scripts/infra/lifecycle.ts ledger",
    "lifecycle:replay": "node --import tsx scripts/infra/lifecycle.ts replay",
    "test:infra": "tsx --test --test-concurrency=1 tests/infra/*.test.ts",
    "test:backend": "playwright test --config playwright.infrastructure.config.ts",
    "test:auth": "playwright test --config playwright.auth.config.ts",
    "test:sync": "playwright test --config playwright.sync.config.ts",
    "push:run": "node --import tsx scripts/infra/push.ts run",
    "push:watch": "node --import tsx scripts/infra/push.ts watch",
    "test:push": "playwright test --config playwright.push.config.ts",
    "test:groups": "playwright test --config playwright.groups.config.ts",
    "ops:check": "node --import tsx scripts/infra/ops.ts check",
    "ops:watch": "node --import tsx scripts/infra/ops.ts watch",
    "ops:drill": "node --import tsx scripts/infra/ops.ts drill",
    "backup:create": "node --import tsx scripts/infra/backup.ts create",
    "backup:drill": "node --import tsx scripts/infra/backup.ts drill",
    "backup:maintain": "node --import tsx scripts/infra/backup.ts maintain",
    "backup:watch": "node --import tsx scripts/infra/backup.ts watch",
    "release:build": "node --import tsx scripts/infra/release.ts build",
    "release:select": "node --import tsx scripts/infra/release.ts select",
    "release:verify": "node --import tsx scripts/infra/release.ts verify",
    "release:rollback": "node --import tsx scripts/infra/release.ts rollback",
    "release:serve": "node --import tsx scripts/infra/release.ts serve",
    "test:rollout": "playwright test --config playwright.rollout.config.ts",
    "check:notices": "node scripts/check-notices.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/geolocation": "8.2.4",
    "@capacitor/ios": "8.5.3",
    "@capacitor/local-notifications": "8.3.1",
    "@vitejs/plugin-react": "6.1.2",
    "adhan": "4.4.6",
    "fastify": "5.12.7",
    "ipaddr.js": "2.5.0",
    "lucide-react": "0.468.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "tz-lookup": "6.1.25",
    "vite": "8.3.4",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/tz-lookup": "6.1.2",
    "@types/web-push": "3.6.4",
    "oxlint": "1.89.0",
    "supabase": "2.121.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": "24.16.0",
    "npm": "11.13.0"
  },
  "packageManager": "npm@11.13.0"
}
