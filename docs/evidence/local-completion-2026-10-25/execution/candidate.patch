+import { createApp } from '../app.ts';
+import type { ServerConfig } from '../config.ts';
+import { sessionInput } from '../auth/routes.ts';
+import { hash } from '../auth/crypto.ts';
+import { RequestMetrics, requestArea, type RequestDiagnostic } from '../operations/requests.ts';
+import { ExecutionPool, type ExecutionOptions } from './pool.ts';
+import type { HTTPMethods } from 'fastify';
+
+/** One HTTP/static listener; no parent database pool. The existing createApp
+ * remains the direct integration-test seam and owns every worker's API rules. */
+export async function createExecutionApp(config: ServerConfig, log: (entry: object) => void = () => {}, options: ExecutionOptions = {}) {
+  const pool = await ExecutionPool.create(config, options);
+  const safeLog = (entry: object) => { try { log(entry); } catch { /* Diagnostics cannot alter a committed response. */ } };
+  try {
+    const app = await createApp(config, () => pool.verify(), entry => {
+      if ('event' in entry && entry.event !== 'request') safeLog(entry);
+    });
+    const originalSnapshot = app.operationsSnapshot();
+    const metrics = new RequestMetrics(config.release, originalSnapshot.webRelease);
+    app.operationsSnapshot = () => metrics.snapshot();
+    app.addHook('onResponse', async (request, reply) => {
+      const path = request.url.split('?')[0];
+      const id = reply.getHeader('x-request-id');
+      const entry: RequestDiagnostic = { event: 'request', requestId: typeof id === 'string' ? id : request.id,
+        area: requestArea(path.startsWith('/api/') ? path : '/*'), status: reply.statusCode,
+        durationMs: Math.max(0, Math.min(60000, Math.round(reply.elapsedTime))), release: config.release,
+        webRelease: originalSnapshot.webRelease, at: new Date().toISOString() };
+      metrics.record(entry); safeLog(entry);
+    });
+    await app.register(async forwarded => {
+      // Preserve raw JSON bytes for the real worker parser. Register the exact
+      // worker-declared limits at ingress too; do not collect a large sync body
+      // for an auth route that only permits 2048 bytes.
+      forwarded.removeAllContentTypeParsers();
+      forwarded.addContentTypeParser('*', { parseAs: 'buffer' }, (_request, body, done) => done(null, body));
+      const routes = pool.routes.filter(route => route.method !== 'HEAD' || !pool.routes.some(other => other.method === 'GET' && other.url === route.url));
+      for (const route of routes) forwarded.route({ method: route.method as HTTPMethods, url: route.url, bodyLimit: route.bodyLimit,
+        handler: async (request, reply) => {
+          try {
+            const session = sessionInput(request, config).session;
+            const response = await pool.request({ method: request.method, url: request.raw.url ?? request.url,
+              headers: request.headers, remoteAddress: request.ip,
+              ...(Buffer.isBuffer(request.body) ? { body: request.body } : {}) }, session ? hash(session).toString('hex') : undefined);
+            // These are trusted worker-generated headers, never client request IDs.
+            reply.code(response.status); reply.headers(response.headers);
+            return reply.send(Buffer.from(response.body));
+          } catch {
+            return reply.code(503).header('Cache-Control', 'no-store').header('Retry-After', '1').send({
+              error: { code: 'unavailable', messageKey: 'auth.unavailable', retryable: true, requestId: request.id },
+            });
+          }
+        },
+      });
+    });
+    app.addHook('preClose', async () => { await pool.close(); });
+    return app;
+  } catch { await pool.close(); throw new Error('execution_start_failed'); }
+}
