+// Fixed-test-only process fault: real BFF/DB commit succeeds, its first receipt
+// is lost with the worker. An exact replay is delivered normally. Never packaged.
+import { parentPort } from 'node:worker_threads';
+import { register } from 'tsx/esm/api';
+const send = parentPort.postMessage.bind(parentPort);
+parentPort.postMessage = message => {
+  if (message.kind === 'response' && message.response.status === 200) {
+    let value; try { value = JSON.parse(Buffer.from(message.response.body).toString()); } catch { /* Non-JSON response. */ }
+    if (value?.operationId && value.operationRevision === 1 && value.replayed === false) process.exit(1);
+  }
+  send(message);
+};
+// Registered before importing the worker, so this synchronous handler runs first.
+parentPort.on('message', message => {
+  if (message.kind === 'request' && message.request.headers['x-synthetic-precommit-loss'] === '1') process.exit(1);
+});
+register();
+await import('../../server/execution/worker.ts');
