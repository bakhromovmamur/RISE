+import { createApp } from '../app.ts';
+import { Sessions } from '../auth/sessions.ts';
+import type { ExecutionRoute, WorkerRequest, WorkerResponse } from './protocol.ts';
+
+if (!parentPort) throw new Error('execution_parent_required');
+const port = parentPort;
+// Only the already-validated restricted runtime configuration crosses this boundary.
+const config = workerData as ServerConfig;
+if (config.database.max !== 5) throw new Error('execution_pool_budget_required');
+config.database = { ...config.database, max: 1 };
+config.sessionKey = Buffer.from(config.sessionKey);
+if (config.push) config.push.dataKey = Buffer.from(config.push.dataKey);
+const store = database(config);
+const send = (value: WorkerResponse) => port.postMessage(value);
+try {
+  await store.verify();
+  const routes: ExecutionRoute[] = [];
+  const app = await createApp(config, store.verify, undefined, new Sessions(config, store.pool), route => {
+    if (!route.url.startsWith('/api/v1/') || route.url.startsWith('/api/v1/health/')) return;
+    for (const method of Array.isArray(route.method) ? route.method : [route.method]) routes.push({ method, url: route.url, bodyLimit: route.bodyLimit ?? 65536 });
+  });
+  await app.ready();
+  port.on('message', (message: WorkerRequest) => {
+    void (async () => {
+      if (message.kind === 'close') { await app.close(); await store.close(); port.close(); return; }
+      if (message.kind === 'verify') {
+        let ok = true; try { await store.verify(); } catch { ok = false; }
+        send({ kind: 'verified', id: message.id, ok }); return;
+      }
+      const request = message.request;
+      const result = await app.inject({ method: request.method, url: request.url, headers: request.headers,
+        remoteAddress: request.remoteAddress, ...(request.body ? { payload: Buffer.from(request.body) } : {}) });
+      send({ kind: 'response', id: message.id, response: { status: result.statusCode, headers: result.headers, body: result.rawPayload } });
+    })().catch(() => { send({ kind: 'failed' }); });
+  });
+  send({ kind: 'ready', routes });
+} catch {
+  await store.close(); send({ kind: 'failed' }); port.close();
+}
