+import { Worker } from 'node:worker_threads';
+import type { ServerConfig } from '../config.ts';
+import { SessionAdmission } from '../auth/admission.ts';
+import type { ExecutionRequest, ExecutionResponse, ExecutionRoute, WorkerRequest, WorkerResponse } from './protocol.ts';
+
+export class ExecutionUnavailable extends Error { constructor() { super('execution_unavailable'); } }
+interface Slot {
+  worker: Worker; ready: boolean; retiring: boolean; count: number; jobs: Set<number>; exited: Promise<void>; startupTimer?: NodeJS.Timeout;
+}
+interface Job { slot: Slot; resolve: (value: ExecutionResponse | boolean) => void; reject: (error: Error) => void; timer: NodeJS.Timeout; deadline: number }
+interface Limits { jobs: number; bytes: number; deadlineMs: number; startupMs: number; drainMs: number }
+const defaults: Limits = { jobs: 256, bytes: 32 * 1024 * 1024, deadlineMs: 15000, startupMs: 15000, drainMs: 15000 };
+/** Constructor seams are used by protocol tests, never selected by HTTP or environment input. */
+export interface ExecutionOptions { workerURL?: URL; limits?: Partial<Limits> }
+
