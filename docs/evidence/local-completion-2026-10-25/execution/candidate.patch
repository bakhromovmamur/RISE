+    // Unexpected runtime/loader output may contain private details. Never forward it.
+    worker.stdout.resume(); worker.stderr.resume();
+    let ended!: () => void;
+    const slot: Slot = { worker, ready: false, retiring: false, count: 0, jobs: new Set(), exited: new Promise(resolve => { ended = resolve; }) };
+    this.slots[index] = slot;
+    return new Promise((resolve, reject) => {
+      let initialized = false;
+      const timer = setTimeout(() => { reject(new ExecutionUnavailable()); void this.retire(index, slot, false); }, this.limits.startupMs);
+      slot.startupTimer = timer;
+      const fail = () => {
+        clearTimeout(timer); reject(new ExecutionUnavailable());
+        void this.retire(index, slot, initialized);
+      };
