+    });
+  }
+  async request(request: ExecutionRequest, sessionKey?: string): Promise<ExecutionResponse> {
+    const bytes = (request.body?.byteLength ?? 0) + Buffer.byteLength(request.url) + Buffer.byteLength(JSON.stringify(request.headers));
+    if (!this.available || this.accepted >= this.limits.jobs || bytes > this.limits.bytes - this.retained) throw new ExecutionUnavailable();
+    const deadline = performance.now() + this.limits.deadlineMs;
+    this.accepted++; this.retained += bytes;
