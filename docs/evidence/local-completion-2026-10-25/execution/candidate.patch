+
+/** Private in-process protocol. Credentials travel in memory only; never log envelopes. */
+export interface ExecutionRequest {
+  method: string; url: string; headers: IncomingHttpHeaders; remoteAddress: string; body?: Uint8Array;
+}
+export interface ExecutionResponse { status: number; headers: OutgoingHttpHeaders; body: Uint8Array }
+export interface ExecutionRoute { method: string; url: string; bodyLimit: number }
+export type WorkerRequest = { kind: 'request'; id: number; request: ExecutionRequest }
+  | { kind: 'verify'; id: number } | { kind: 'close' };
+export type WorkerResponse = { kind: 'ready'; routes: ExecutionRoute[] } | { kind: 'failed' }
+  | { kind: 'response'; id: number; response: ExecutionResponse }
+  | { kind: 'verified'; id: number; ok: boolean };
