+// Synthetic transport peer only. Production never selects this module.
+import { parentPort, threadId, workerData } from 'node:worker_threads';
+if (workerData.release === 'fail-start') { parentPort.postMessage({ kind: 'failed' }); parentPort.close(); }
+else {
+  let active = 0;
+  parentPort.postMessage({ kind: 'ready', routes: [
+    {method:'POST',url:'/api/v1/personal/commands',bodyLimit:65536},
+    {method:'POST',url:'/api/v1/auth/code',bodyLimit:2048},
+    {method:'POST',url:'/api/v1/sync/commands',bodyLimit:524288},
+    {method:'GET',url:'/api/v1/binary',bodyLimit:65536},
+    {method:'HEAD',url:'/api/v1/binary',bodyLimit:65536},
+  ] });
+  parentPort.on('message', async message => {
+    if (message.kind === 'close') { parentPort.close(); return; }
+    if (message.kind === 'verify') { parentPort.postMessage({ kind: 'verified', id: message.id, ok: workerData.release !== 'fail-verify' }); return; }
+    const { request, id } = message;
+    if (request.url === '/crash') { process.exit(1); }
+    if (request.url === '/hang') return;
+    active++;
+    const overlap = active;
+    if (request.url === '/delay') await new Promise(resolve => setTimeout(resolve, 80));
+    active--;
+    const body = request.url === '/binary' ? new Uint8Array([0, 255, 1, 128]) : Buffer.from(JSON.stringify({
+      threadId, overlap, body: request.body ? Buffer.from(request.body).toString() : null,
+      ip: request.remoteAddress, url: request.url, headers: request.headers, environmentEmpty: Object.keys(process.env).length === 0,
+    }));
+    parentPort.postMessage({ kind: 'response', id, response: { status: 201, body, headers: {
+      'content-type': request.url === '/binary' ? 'application/octet-stream' : 'application/json',
+      'set-cookie': ['a=1; HttpOnly', 'b=2; HttpOnly'], 'x-request-id': `trusted-worker-${threadId}`,
+    } } });
+  });
+}
