+
+  private constructor(private readonly config: ServerConfig, options: ExecutionOptions) {
+    if (config.database.max !== 5) throw new Error('execution_pool_budget_required');
+    this.limits = { ...defaults, ...options.limits };
+    this.workerURL = options.workerURL ?? new URL('./bootstrap.mjs', import.meta.url);
+  }
+  static async create(config: ServerConfig, options: ExecutionOptions = {}) {
+    const pool = new ExecutionPool(config, options);
+    try { await Promise.all(Array.from({ length: 5 }, (_, index) => pool.start(index))); return pool; }
+    catch { await pool.close(); throw new ExecutionUnavailable(); }
+  }
+  get available() { return !this.closing && this.slots.length === 5 && this.slots.every(slot => slot.ready && !slot.retiring); }
+  get routes(): readonly ExecutionRoute[] { return this.manifest ?? []; }
+
+  private start(index: number): Promise<void> {
+    // Dedicated typed-array backing stores prevent cloning unrelated bytes from
+    // Node's pooled Buffer allocations along with these narrow runtime keys.
+    const workerData = { ...this.config, sessionKey: Uint8Array.from(this.config.sessionKey),
+      ...(this.config.push ? { push: { ...this.config.push, dataKey: Uint8Array.from(this.config.push.dataKey) } } : {}) };
